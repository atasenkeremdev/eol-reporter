# Copy to .env and fill in your Azure OpenAI resource settings.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TIMEOUT_SECONDS=90
# Optional: trusted PEM CA bundle for a corporate TLS proxy. Never disable TLS verification.
# AZURE_OPENAI_CA_BUNDLE=/path/to/trusted-ca-bundle.pem
# Standard HTTPS_PROXY and NO_PROXY settings are respected when configured.
